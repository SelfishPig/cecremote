[Unit]
Description=HDMI-CEC Remote REST API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
Group=%i
SupplementaryGroups=video
WorkingDirectory=/home/%i/cecremote
Environment="CEC_CLIENT=/usr/bin/cec-client"
Environment="LOG_LEVEL=INFO"
ExecStart=/home/%i/cecremote/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
